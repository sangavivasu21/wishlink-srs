SELECT * FROM Product;

UPDATE Product
SET Price = 57000.00,
    Stock = 12
WHERE Product_ID = 1;

DELETE FROM Product
WHERE Product_ID = 6;

SELECT 
    p.Product_ID,
    p.Product_Name,
    c.Category_Name,
    p.Price,
    p.Stock
FROM Product p
JOIN Category c
ON p.Category_ID = c.Category_ID;

SELECT 
    c.Category_Name,
    COUNT(p.Product_ID) AS Total_Products,
    SUM(p.Stock) AS Total_Stock,
    SUM(p.Price * p.Stock) AS Total_Stock_Value
FROM Category c
LEFT JOIN Product p
ON c.Category_ID = p.Category_ID
GROUP BY c.Category_ID, c.Category_Name;
